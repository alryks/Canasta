# Used by docker-compose.prod.yml. Copy to `.env` and fill in real values
# before running `docker compose -f docker-compose.prod.yml up --build`.

# Postgres
POSTGRES_USER=canasta
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=canasta

# Backend
# JSON array of origins allowed to call the API/WS -- must be the public
# URL the browser loads the frontend from.
CORS_ORIGINS=["https://your-domain.example"]
SECRET_KEY=change-me-to-a-long-random-string

# Frontend -- baked into the static build at image-build time, must be the
# URL the *browser* can reach the backend at (not an in-network hostname).
VITE_API_BASE_URL=https://your-domain.example:8000
